// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Tudo em inglês: tabelas, colunas, enums, models, código e contrato JSON (constituição v4.0.0,
// III; ADR 0008). Nenhuma camada traduz nomes.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum VisitType {
  visitor
  delivery
  service_provider
}

/// Visita esperada numa unidade, autorizada por alguém com vínculo naquele condomínio.
model Visitor {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(60)
  type           VisitType
  expectedDate   DateTime  @map("expected_date") @db.Date
  /// Quem autorizou a visita. Vem SEMPRE do token, nunca do body (FR-022).
  authorizedById String    @map("authorized_by_id")
  unitId         String    @map("unit_id")
  /// Repetido de propósito: amarra as duas FKs compostas ao mesmo condomínio (research R-002).
  condominiumId  String    @map("condominium_id")
  /// O código do comprovante desta visita, que vai no QR. Gerado pelo BANCO, para valer para
  /// qualquer escritor — a API, a carga, um script. Não é o `id` de propósito: o administrador
  /// recebe o `id` de toda visita do condomínio, e o código só pode chegar a quem a autorizou.
  passCode       String    @unique @default(dbgenerated("gen_random_uuid()")) @map("pass_code") @db.Uuid
  /// Quando o visitante ENTROU: o momento da primeira conferência do comprovante que respondeu
  /// "válido" (feature 015). `null` até lá; gravado UMA vez e nunca mais alterado nem apagado.
  /// É um INSTANTE, como `postedAt` de um achado e ao contrário de `expectedDate`, que é um dia
  /// de calendário: trafega em ISO 8601 completo e é lido na hora local. Só a conferência grava.
  enteredAt      DateTime? @map("entered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  /// Aponta para o vínculo, e não direto para o usuário: só existe se quem autorizou pertence ao
  /// condomínio da visita. Mesmo padrão de UnitResident (research R-002).
  authorizedBy CondominiumMember @relation(fields: [authorizedById, condominiumId], references: [userId, condominiumId], onDelete: Cascade)
  /// A FK composta garante unidade do MESMO condomínio da visita.
  unit         Unit              @relation(fields: [unitId, condominiumId], references: [id, condominiumId], onDelete: Restrict)

  @@index([expectedDate])
  @@index([condominiumId, expectedDate])
  @@index([unitId, condominiumId])
  @@map("visitors")
}

/// Cargo de um usuário em um condomínio.
///
/// `manager` (síndico) e `doorman` (portaria) saíram na feature 007, quando o papel de gestão
/// virou `admin` (administrador). Na feature 013 o SÍNDICO VOLTOU, como um cargo próprio e não
/// como outro nome do administrador: é quem cria o condomínio. São três cargos, e um condomínio
/// pode ter um administrador E um síndico (ADR 0017).
///
/// Quem "cuida" de um condomínio é o administrador ou o síndico — a pergunta é feita num lugar só,
/// `managesCondominium` em `src/lib/roles.ts`, nunca comparando com `admin`.
///
/// Na feature 014 o PORTEIRO também voltou, e são quatro cargos. Ele não cuida do condomínio e,
/// por enquanto, só lê: quem responde "este cargo age aqui?" é `actsInCondominium`, no mesmo
/// arquivo.
enum Role {
  resident
  admin
  /// Síndico: quem criou o condomínio. No máximo um por condomínio.
  manager
  /// Porteiro: qualquer número por condomínio, sem unidade. Não cuida do condomínio e, por
  /// enquanto, só lê.
  doorman
}

// As CHECKs (nome, e-mail, bloco, número) e as triggers de "morador tem unidade" não cabem no
// schema: estão na migration create_users_condominiums (research R-005, R-010).

model Condominium {
  id          String              @id @default(uuid())
  name        String              @db.VarChar(100)
  /// Endereço da foto do condomínio: aparece no card da escolha de condomínio e no banner da
  /// home. `null` é "sem foto", e o app mostra o placeholder. A CHECK de `https://` está na
  /// migration add_condominium_image (ADR 0004).
  imageUrl    String?             @map("image_url")
  /// Endereço, em texto livre. `null` só nos condomínios que já existiam antes de dar para criar
  /// um pelo app (feature 013); todo condomínio criado pelo formulário tem um.
  address     String?             @db.VarChar(200)
  /// A foto ENVIADA pelo síndico, em bytes. NENHUMA lista seleciona esta coluna: toda consulta em
  /// `condominiums` nomeia as colunas que lê, e só `readCondominiumPhoto` lê esta (ADR 0012).
  /// Um condomínio tem foto por aqui, por `imageUrl`, ou não tem.
  photo            Bytes?
  /// O tipo que o SERVIDOR detectou nos bytes, nunca o que quem enviou disse.
  photoContentType String?        @map("photo_content_type") @db.VarChar(20)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  units       Unit[]
  joinRequests JoinRequest[]
  members     CondominiumMember[]
  commonAreas CommonArea[]
  notices     Notice[]
  foundItems  FoundItem[]

  @@map("condominiums")
}

/// Em que pé está um item de achados e perdidos. São dois valores e mais nenhum: o enum é o banco
/// dizendo que um terceiro não pode ser gravado por caminho nenhum (feature 008, SC-007).
enum FoundItemStatus {
  /// Encontrado, à espera do dono. É como todo item começa.
  found
  /// Devolvido ao dono. O item continua na lista.
  returned
}

/// Item encontrado no condomínio, à espera do dono: achados e perdidos.
///
/// As CHECKs de descrição, local, tamanho e tipo da foto estão na migration add_found_items,
/// porque o Prisma não as expressa (ADR 0004).
///
/// É a primeira entidade do projeto cujo estado MUDA depois de criada (`status`), a primeira com
/// um instante em vez de um dia de calendário (`postedAt`) e a primeira a guardar um arquivo.
model FoundItem {
  id               String          @id @default(uuid())
  condominiumId    String          @map("condominium_id")
  /// Quem postou. Vem SEMPRE do token; gravado para responsabilização, nunca exibido (FR-006).
  postedById       String          @map("posted_by_id")
  description      String          @db.VarChar(200)
  /// Onde foi encontrado.
  place            String          @db.VarChar(120)
  status           FoundItemStatus @default(found)
  /// O momento da postagem, um INSTANTE. Preenchido pelo banco, nunca aceito de quem posta
  /// (FR-005). Separado de `createdAt` porque o nome da coluna é o nome que trafega no JSON, e
  /// `createdAt` é contabilidade que toda tabela tem (research R-009).
  postedAt         DateTime        @default(now()) @map("posted_at") @db.Timestamptz(3)
  /// A foto em si, dentro da linha: assim item sem foto não existe e postar é uma escrita só
  /// (research R-001, ADR 0012). NENHUMA listagem pode selecionar esta coluna — ela só sai pela
  /// rota da foto.
  photo            Bytes
  /// Detectado pelo servidor a partir dos bytes, nunca informado por quem envia (research R-004).
  photoContentType String          @map("photo_content_type") @db.VarChar(20)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  condominium Condominium       @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  /// Aponta para o USUÁRIO, e não mais para o vínculo (feature 014, ADR 0019), pelo mesmo motivo
  /// dos avisos: a prateleira é do condomínio e fica quando quem postou é removido dele. O
  /// `Restrict` continua valendo para a CONTA. Que quem posta pertence ao condomínio é o service
  /// que confere, antes de gravar.
  postedBy    User              @relation(fields: [postedById], references: [id], onDelete: Restrict)

  @@index([condominiumId, postedAt(sort: Desc), id])
  @@map("found_items")
}

/// Aviso do condomínio: o mural, com título, corpo e data.
///
/// As CHECKs de título e corpo estão na migration add_notices, porque o Prisma não as expressa
/// (ADR 0004). O corpo NÃO é guardado aparado: cortar espaços comeria a linha em branco que separa
/// dois parágrafos, e preservá-la é requisito (FR-002).
model Notice {
  id            String   @id @default(uuid())
  condominiumId String   @map("condominium_id")
  /// Quem publicou. O id nunca é exposto; o nome exibido de quem publicou é (RN-MEM-04).
  publishedById String   @map("published_by_id")
  title         String   @db.VarChar(120)
  /// Texto completo, quebras de linha incluídas. Limitado a 5000 caracteres pela CHECK.
  body          String
  /// Dia a que o aviso se refere; a lista ordena por ele.
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  condominium Condominium       @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  /// Aponta para o USUÁRIO, e não mais para o vínculo (feature 014, ADR 0019).
  ///
  /// Até a 014 era uma FK composta para `condominium_members`, com `Restrict`, para o mural não se
  /// perder numa troca de administrador. Só que nada trocava administrador: o que o `Restrict`
  /// fazia na prática era impedir o vínculo de ser apagado. Agora o síndico remove pessoas, e o
  /// aviso tem de ficar — então ele aponta para a pessoa. O `Restrict` continua valendo para a
  /// CONTA: quem publicou não apaga a própria conta (`hasRecords`).
  ///
  /// O que se perdeu: o banco não garante mais que quem publicou pertencia ao condomínio. Quem
  /// confere é o service, antes de gravar — e um vínculo que acaba é justamente o caso que a
  /// coluna precisa aceitar.
  publishedBy User              @relation(fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([condominiumId, date(sort: Desc), id])
  @@map("notices")
}

/// Local do condomínio que dá para reservar: salão, quiosque, quadra, churrasqueira.
///
/// As CHECKs de nome, taxa e endereço da foto estão na migration
/// add_common_areas_and_reservations, porque o Prisma não as expressa (ADR 0004).
model CommonArea {
  id            String   @id @default(uuid())
  condominiumId String   @map("condominium_id")
  name          String   @db.VarChar(60)
  /// Quanto custa usar, em reais. `0` significa de graça, nunca "não informado" (FR-003).
  usageFee      Decimal  @default(0) @map("usage_fee") @db.Decimal(10, 2)
  /// Endereço https da foto. `null` cai no placeholder da tela (research R-007).
  imageUrl      String?  @map("image_url")
  /// A foto ENVIADA pelo síndico ao criar o local, em bytes. NENHUMA lista seleciona esta coluna:
  /// toda consulta em `common_areas` nomeia as colunas que lê, e só `readCommonAreaPhoto` lê
  /// esta (ADR 0012). Um local tem foto por aqui, por `imageUrl` (dados de exemplo), ou não tem.
  photo            Bytes?
  /// O tipo que o SERVIDOR detectou nos bytes, nunca o que quem enviou disse.
  photoContentType String?  @map("photo_content_type") @db.VarChar(20)
  /// `false` fecha o local para novas reservas SEM apagar o registro nem o histórico (FR-002a). Ele
  /// continua no catálogo, marcado; quem liga e desliga é o administrador (feature 011).
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  condominium  Condominium   @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  // Dois locais do mesmo condomínio não podem ter o mesmo nome: o card mostra o nome e mais nada,
  // então o morador não teria como distinguir (research R-006).
  @@unique([condominiumId, name])
  // Alvo da FK composta de Reservation: garante local do mesmo condomínio da reserva (R-002).
  @@unique([id, condominiumId])
  @@index([condominiumId, isAvailable])
  @@map("common_areas")
}

/// Horário reservado de uma área comum.
///
/// NÃO tem coluna de situação: a existência da linha É a reserva, e liberar o horário apaga o
/// registro (FR-013a). O horário é guardado como minutos desde a meia-noite, e não como hora, para
/// que nenhum fuso possa deslocá-lo — ver research R-001.
model Reservation {
  id            String   @id @default(uuid())
  commonAreaId  String   @map("common_area_id")
  reservedById  String   @map("reserved_by_id")
  /// Repetido de propósito: amarra as duas FKs compostas ao mesmo condomínio (research R-002).
  condominiumId String   @map("condominium_id")
  date          DateTime @db.Date
  /// Minutos desde a meia-noite, no relógio do condomínio. `840` é 14:00.
  startMinute   Int      @map("start_minute")
  /// Fim exclusivo, mesma escala. `1320` é 22:00. A CHECK garante maior que `startMinute`.
  endMinute     Int      @map("end_minute")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// A FK composta garante local do MESMO condomínio da reserva.
  commonArea CommonArea        @relation(fields: [commonAreaId, condominiumId], references: [id, condominiumId], onDelete: Restrict)
  /// Aponta para o vínculo, não para o usuário: só existe se quem reservou pertence ao condomínio.
  reservedBy CondominiumMember @relation(fields: [reservedById, condominiumId], references: [userId, condominiumId], onDelete: Cascade)

  // NADA de duas reservas no mesmo horário do mesmo local. Como a grade é fixa e toda reserva se
  // alinha a ela, duas reservas do mesmo horário carregam obrigatoriamente os MESMOS três valores:
  // a reserva dupla deixa de ser pergunta sobre intervalos e passa a ser chave duplicada, que o
  // Postgres recusa sem ser pedido duas vezes. Dois INSERTs simultâneos chegam ao índice, um passa
  // e o outro é recusado pelo banco — não por um "confere antes de gravar", que os dois passariam
  // (research R-001). `endMinute` fica fora da chave: a CHECK o amarra a `startMinute + 120`.
  @@unique([commonAreaId, date, startMinute])
  // A grade em si é uma CHECK escrita à mão na migration (`reservations_slot_grid_check`): o Prisma
  // não expressa CHECK (ADR 0004), e a regra precisa valer para a seed e para scripts, não só para
  // quem passa pela API (research R-002).
  @@index([commonAreaId, date])
  @@map("reservations")
}

model Unit {
  id            String         @id @default(uuid())
  condominiumId String         @map("condominium_id")
  /// `null` = condomínio sem blocos. Guardado em maiúsculas (research R-005).
  block         String?        @db.VarChar(20)
  /// Guardado em maiúsculas (research R-005).
  number        String         @db.VarChar(10)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  condominium   Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  residents     UnitResident[]
  visitors      Visitor[]
  joinRequests  JoinRequest[]

  // Alvo da FK composta de UnitResident: garante unidade do mesmo condomínio do vínculo (R-002).
  @@unique([id, condominiumId])
  @@unique([condominiumId, block, number])
  // NULL não se repete em índice único; este cobre as unidades sem bloco (research R-004).
  @@unique([condominiumId, number], map: "units_number_without_block_key", where: raw("block IS NULL"))
  @@map("units")
}

model User {
  id            String              @id @default(uuid())
  name          String              @db.VarChar(100)
  /// Guardado em minúsculas; único no sistema todo (research R-005).
  email         String              @unique @db.VarChar(254)
  /// `scrypt$N$r$p$salt$hash` (research R-006). Nunca a senha.
  passwordHash  String              @map("password_hash")
  /// `true` desde a criação da conta PELO SÍNDICO até a pessoa trocar a password (feature 014).
  /// Nunca volta a `true`: é isso que deixa a marca no token ser segura (ADR 0018). Enquanto for
  /// `true`, a conta só alcança o próprio perfil e a troca de password.
  passwordIsProvisional Boolean     @default(false) @map("password_is_provisional")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  memberships   CondominiumMember[]
  refreshTokens RefreshToken[]
  /// O pedido de entrada desta pessoa num condomínio, enquanto estiver pendente. No máximo um.
  joinRequest   JoinRequest?
  /// O que a pessoa publicou e postou. Apontam para cá, e não para o vínculo, desde a feature 014.
  notices       Notice[]
  foundItems    FoundItem[]

  @@map("users")
}

/// Vínculo usuário × condomínio, com o cargo naquele condomínio.
model CondominiumMember {
  userId           String         @map("user_id")
  condominiumId    String         @map("condominium_id")
  role             Role
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  condominium      Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  residences       UnitResident[]
  authorizedVisits Visitor[]
  reservations     Reservation[]

  @@id([userId, condominiumId])
  // No máximo um administrador por condomínio. Herdado da regra do síndico (research R-003), que
  // era um cargo eletivo único; vale reavaliar se uma administradora puder ter várias pessoas.
  @@unique([condominiumId], map: "condominium_members_one_admin_key", where: raw("role = 'admin'"))
  // No máximo um síndico por condomínio, do mesmo jeito. Os dois índices são independentes: um
  // condomínio pode ter um administrador e um síndico, que são pessoas diferentes (ADR 0017).
  @@unique([condominiumId], map: "condominium_members_one_manager_key", where: raw("role = 'manager'"))
  // E uma PESSOA é síndica de no máximo um condomínio: quem já criou o seu não cria outro. É este
  // índice, e não uma conferência no service, que segura dois pedidos simultâneos da mesma conta.
  @@unique([userId], map: "condominium_members_one_condominium_per_manager_key", where: raw("role = 'manager'"))
  @@index([condominiumId])
  @@map("condominium_members")
}

/// Moradia: usuário × unidade. Aponta para o vínculo, e não direto para o usuário, para só existir
/// com vínculo no condomínio da unidade (research R-002).
model UnitResident {
  userId        String            @map("user_id")
  unitId        String            @map("unit_id")
  /// Repetido de propósito: amarra as duas FKs compostas ao mesmo condomínio.
  condominiumId String            @map("condominium_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  member        CondominiumMember @relation(fields: [userId, condominiumId], references: [userId, condominiumId], onDelete: Cascade)
  unit          Unit              @relation(fields: [unitId, condominiumId], references: [id, condominiumId], onDelete: Restrict)

  @@id([userId, unitId])
  @@index([unitId, condominiumId])
  @@map("unit_residents")
}

/// Pedido de entrada de uma pessoa num condomínio, como moradora de uma unidade (feature 016).
///
/// **A linha existir É o "pendente".** Não há coluna de situação e não há histórico: aprovar,
/// rejeitar e desistir APAGAM a linha — do mesmo jeito que a existência de uma reserva é a reserva.
/// Toda resposta começa por esse `DELETE`, e só segue quem de fato apagou: é isso que dá um
/// resultado só a duas respostas simultâneas (ADR 0021).
///
/// Não é um vínculo com uma marca de "pendente", de propósito: todas as conferências de permissão
/// leem `condominium_members`, e cada uma teria de lembrar de excluir os pendentes — uma esquecida
/// é um estranho dentro do prédio.
model JoinRequest {
  id            String   @id @default(uuid())
  /// Único: uma pessoa tem no máximo um pedido. Sai junto com a conta.
  userId        String   @unique @map("user_id")
  condominiumId String   @map("condominium_id")
  unitId        String   @map("unit_id")
  /// Quando foi pedido. Um INSTANTE, lido na hora local de quem olha.
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  /// A FK composta garante que a unidade pedida é do MESMO condomínio do pedido.
  unit        Unit        @relation(fields: [unitId, condominiumId], references: [id, condominiumId], onDelete: Restrict)

  // A lista de um condomínio, do pedido mais antigo para o mais novo.
  @@index([condominiumId, createdAt, id])
  @@map("join_requests")
}

// Renovação de sessão (feature 004). O valor da credencial nunca é gravado: só o hash SHA-256.
// Não existe tabela de sessão: a sessão É a cadeia de credenciais de renovação, e o prazo
// acompanha cada credencial emitida (ADR 0007).

/// Cada credencial de renovação emitida. Rotaciona a cada uso; a antiga fica revogada.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  /// SHA-256 em hex do valor entregue ao aplicativo.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Renovar emite uma credencial nova com prazo novo: quem usa o aplicativo não perde a sessão.
  expiresAt DateTime  @map("expires_at")
  /// Preenchido na rotação e ao sair. `null` = a credencial ainda vale.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Contador do bloqueio de entrada (FR-005) e do limite de cadastro (FR-032).
/// A chave é texto e não referencia `users`: e-mail inexistente também é contado (FR-003).
model LoginAttempt {
  /// `email:<e-mail>`, `ip:<origem>` ou `signup-ip:<origem>`.
  key             String    @id @db.VarChar(320)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")

  @@map("login_attempts")
}
