// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Tudo em inglês: tabelas, colunas, enums, models, código e contrato JSON (constituição v4.0.0,
// III; ADR 0008). Nenhuma camada traduz nomes.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum VisitType {
  visitor
  delivery
  service_provider
}

/// Visita esperada numa unidade, autorizada por alguém com vínculo naquele condomínio.
model Visitor {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(60)
  type           VisitType
  expectedDate   DateTime  @map("expected_date") @db.Date
  /// Quem autorizou a visita. Vem SEMPRE do token, nunca do body (FR-022).
  authorizedById String    @map("authorized_by_id")
  unitId         String    @map("unit_id")
  /// Repetido de propósito: amarra as duas FKs compostas ao mesmo condomínio (research R-002).
  condominiumId  String    @map("condominium_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  /// Aponta para o vínculo, e não direto para o usuário: só existe se quem autorizou pertence ao
  /// condomínio da visita. Mesmo padrão de UnitResident (research R-002).
  authorizedBy CondominiumMember @relation(fields: [authorizedById, condominiumId], references: [userId, condominiumId], onDelete: Cascade)
  /// A FK composta garante unidade do MESMO condomínio da visita.
  unit         Unit              @relation(fields: [unitId, condominiumId], references: [id, condominiumId], onDelete: Restrict)

  @@index([expectedDate])
  @@index([condominiumId, expectedDate])
  @@index([unitId, condominiumId])
  @@map("visitors")
}

/// Cargo de um usuário em um condomínio.
///
/// `manager` (síndico) e `doorman` (portaria) saíram na feature 007: o papel de gestão virou
/// `admin` (administrador), e por enquanto é o único além de morador. Nenhuma linha usava os dois
/// removidos quando a troca aconteceu.
enum Role {
  resident
  admin
}

// As CHECKs (nome, e-mail, bloco, número) e as triggers de "morador tem unidade" não cabem no
// schema: estão na migration create_users_condominiums (research R-005, R-010).

model Condominium {
  id          String              @id @default(uuid())
  name        String              @db.VarChar(100)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  units       Unit[]
  members     CondominiumMember[]
  commonAreas CommonArea[]
  notices     Notice[]

  @@map("condominiums")
}

/// Aviso do condomínio: o mural, com título, corpo e data.
///
/// As CHECKs de título e corpo estão na migration add_notices, porque o Prisma não as expressa
/// (ADR 0004). O corpo NÃO é guardado aparado: cortar espaços comeria a linha em branco que separa
/// dois parágrafos, e preservá-la é requisito (FR-002).
model Notice {
  id            String   @id @default(uuid())
  condominiumId String   @map("condominium_id")
  /// Quem publicou. Gravado para responsabilização, nunca exibido (FR-004).
  publishedById String   @map("published_by_id")
  title         String   @db.VarChar(120)
  /// Texto completo, quebras de linha incluídas. Limitado a 5000 caracteres pela CHECK.
  body          String
  /// Dia a que o aviso se refere; a lista ordena por ele.
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  condominium Condominium       @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  /// A FK composta garante que quem publicou pertence ao condomínio do aviso.
  ///
  /// `Restrict`, e não `Cascade` como em visitors, de propósito: uma visita é sobre uma pessoa
  /// receber alguém e sai com ela, enquanto um aviso é o condomínio falando. Perder o mural porque
  /// o administrador foi trocado seria defeito, não cascata (research R-008).
  publishedBy CondominiumMember @relation(fields: [publishedById, condominiumId], references: [userId, condominiumId], onDelete: Restrict)

  @@index([condominiumId, date(sort: Desc), id])
  @@map("notices")
}

/// Local do condomínio que dá para reservar: salão, quiosque, quadra, churrasqueira.
///
/// As CHECKs de nome, taxa e endereço da foto estão na migration
/// add_common_areas_and_reservations, porque o Prisma não as expressa (ADR 0004).
model CommonArea {
  id            String   @id @default(uuid())
  condominiumId String   @map("condominium_id")
  name          String   @db.VarChar(60)
  /// Quanto custa usar, em reais. `0` significa de graça, nunca "não informado" (FR-003).
  usageFee      Decimal  @default(0) @map("usage_fee") @db.Decimal(10, 2)
  /// Endereço https da foto. `null` cai no placeholder da tela (research R-007).
  imageUrl      String?  @map("image_url")
  /// `false` esconde do catálogo SEM apagar o registro nem o histórico (FR-002a).
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  condominium  Condominium   @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  // Dois locais do mesmo condomínio não podem ter o mesmo nome: o card mostra o nome e mais nada,
  // então o morador não teria como distinguir (research R-006).
  @@unique([condominiumId, name])
  // Alvo da FK composta de Reservation: garante local do mesmo condomínio da reserva (R-002).
  @@unique([id, condominiumId])
  @@index([condominiumId, isAvailable])
  @@map("common_areas")
}

/// Horário reservado de uma área comum.
///
/// NÃO tem coluna de situação: a existência da linha É a reserva, e liberar o horário apaga o
/// registro (FR-013a). O horário é guardado como minutos desde a meia-noite, e não como hora, para
/// que nenhum fuso possa deslocá-lo — ver research R-001.
model Reservation {
  id            String   @id @default(uuid())
  commonAreaId  String   @map("common_area_id")
  reservedById  String   @map("reserved_by_id")
  /// Repetido de propósito: amarra as duas FKs compostas ao mesmo condomínio (research R-002).
  condominiumId String   @map("condominium_id")
  date          DateTime @db.Date
  /// Minutos desde a meia-noite, no relógio do condomínio. `840` é 14:00.
  startMinute   Int      @map("start_minute")
  /// Fim exclusivo, mesma escala. `1320` é 22:00. A CHECK garante maior que `startMinute`.
  endMinute     Int      @map("end_minute")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// A FK composta garante local do MESMO condomínio da reserva.
  commonArea CommonArea        @relation(fields: [commonAreaId, condominiumId], references: [id, condominiumId], onDelete: Restrict)
  /// Aponta para o vínculo, não para o usuário: só existe se quem reservou pertence ao condomínio.
  reservedBy CondominiumMember @relation(fields: [reservedById, condominiumId], references: [userId, condominiumId], onDelete: Cascade)

  // NADA de duas reservas no mesmo horário do mesmo local. Como a grade é fixa e toda reserva se
  // alinha a ela, duas reservas do mesmo horário carregam obrigatoriamente os MESMOS três valores:
  // a reserva dupla deixa de ser pergunta sobre intervalos e passa a ser chave duplicada, que o
  // Postgres recusa sem ser pedido duas vezes. Dois INSERTs simultâneos chegam ao índice, um passa
  // e o outro é recusado pelo banco — não por um "confere antes de gravar", que os dois passariam
  // (research R-001). `endMinute` fica fora da chave: a CHECK o amarra a `startMinute + 120`.
  @@unique([commonAreaId, date, startMinute])
  // A grade em si é uma CHECK escrita à mão na migration (`reservations_slot_grid_check`): o Prisma
  // não expressa CHECK (ADR 0004), e a regra precisa valer para a seed e para scripts, não só para
  // quem passa pela API (research R-002).
  @@index([commonAreaId, date])
  @@map("reservations")
}

model Unit {
  id            String         @id @default(uuid())
  condominiumId String         @map("condominium_id")
  /// `null` = condomínio sem blocos. Guardado em maiúsculas (research R-005).
  block         String?        @db.VarChar(20)
  /// Guardado em maiúsculas (research R-005).
  number        String         @db.VarChar(10)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  condominium   Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  residents     UnitResident[]
  visitors      Visitor[]

  // Alvo da FK composta de UnitResident: garante unidade do mesmo condomínio do vínculo (R-002).
  @@unique([id, condominiumId])
  @@unique([condominiumId, block, number])
  // NULL não se repete em índice único; este cobre as unidades sem bloco (research R-004).
  @@unique([condominiumId, number], map: "units_number_without_block_key", where: raw("block IS NULL"))
  @@map("units")
}

model User {
  id            String              @id @default(uuid())
  name          String              @db.VarChar(100)
  /// Guardado em minúsculas; único no sistema todo (research R-005).
  email         String              @unique @db.VarChar(254)
  /// `scrypt$N$r$p$salt$hash` (research R-006). Nunca a senha.
  passwordHash  String              @map("password_hash")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  memberships   CondominiumMember[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Vínculo usuário × condomínio, com o cargo naquele condomínio.
model CondominiumMember {
  userId           String         @map("user_id")
  condominiumId    String         @map("condominium_id")
  role             Role
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  condominium      Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  residences       UnitResident[]
  authorizedVisits Visitor[]
  notices          Notice[]
  reservations     Reservation[]

  @@id([userId, condominiumId])
  // No máximo um administrador por condomínio. Herdado da regra do síndico (research R-003), que
  // era um cargo eletivo único; vale reavaliar se uma administradora puder ter várias pessoas.
  @@unique([condominiumId], map: "condominium_members_one_admin_key", where: raw("role = 'admin'"))
  @@index([condominiumId])
  @@map("condominium_members")
}

/// Moradia: usuário × unidade. Aponta para o vínculo, e não direto para o usuário, para só existir
/// com vínculo no condomínio da unidade (research R-002).
model UnitResident {
  userId        String            @map("user_id")
  unitId        String            @map("unit_id")
  /// Repetido de propósito: amarra as duas FKs compostas ao mesmo condomínio.
  condominiumId String            @map("condominium_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  member        CondominiumMember @relation(fields: [userId, condominiumId], references: [userId, condominiumId], onDelete: Cascade)
  unit          Unit              @relation(fields: [unitId, condominiumId], references: [id, condominiumId], onDelete: Restrict)

  @@id([userId, unitId])
  @@index([unitId, condominiumId])
  @@map("unit_residents")
}

// Renovação de sessão (feature 004). O valor da credencial nunca é gravado: só o hash SHA-256.
// Não existe tabela de sessão: a sessão É a cadeia de credenciais de renovação, e o prazo
// acompanha cada credencial emitida (ADR 0007).

/// Cada credencial de renovação emitida. Rotaciona a cada uso; a antiga fica revogada.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  /// SHA-256 em hex do valor entregue ao aplicativo.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Renovar emite uma credencial nova com prazo novo: quem usa o aplicativo não perde a sessão.
  expiresAt DateTime  @map("expires_at")
  /// Preenchido na rotação e ao sair. `null` = a credencial ainda vale.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Contador do bloqueio de entrada (FR-005) e do limite de cadastro (FR-032).
/// A chave é texto e não referencia `users`: e-mail inexistente também é contado (FR-003).
model LoginAttempt {
  /// `email:<e-mail>`, `ip:<origem>` ou `signup-ip:<origem>`.
  key             String    @id @db.VarChar(320)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")

  @@map("login_attempts")
}
