# Copie este arquivo para .env e troque SENHA pela senha do docker-compose.yml.
# O .env nunca vai para o git; este exemplo vai.

DATABASE_URL="postgresql://condfy:SENHA@localhost:5432/condfy?schema=public"

# Opcionais: o código usa estes valores quando as variáveis não existem.
PORT=3333
CORS_ORIGIN=http://localhost:8081
