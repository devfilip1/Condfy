# Copie este arquivo para .env.local (ignorado pelo git) e ajuste para o seu alvo.
#
#   Aparelho físico com Expo Go:  http://<IP do PC na rede Wi-Fi>:3333   (ipconfig → Endereço IPv4)
#   Emulador Android:             http://10.0.2.2:3333
#   Web (expo start --web):       http://localhost:3333
#
# Depois de mudar este valor, reinicie o Metro com: npx expo start --clear

EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
